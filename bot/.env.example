# Copy to your server's environment settings. Never commit real values.
HELIUS_API_KEY=            # required: your Helius key (RPC + websocket)
TELEGRAM_BOT_TOKEN=        # optional: from @BotFather
TELEGRAM_CHAT_ID=          # optional: your chat id (message @userinfobot)
DATA_DIR=./data            # where events, daily reports and collected coins are written (use a persistent volume)
PORT=8080                  # /health and /status
FEED_MODE=logs             # logs (any plan) | transactions (Helius enhanced websocket)
EXIT_STYLE=runner          # runner | steady
PAPER_BANKROLL=10          # SOL (paper only)
SIZE_FRAC=0.03             # share of the day's bankroll per trade
MAX_TRADES_PER_DAY=15
MAX_OPEN=4
DAILY_LOSS_CAP=0.10
ALERTS=trades              # trades | daily | off
COLLECT=all                # all | active | off (finished coins written for the backtest)
TZ_OFFSET_MIN=0            # day boundary for reports, minutes from UTC (e.g. -300 for New York winter)
